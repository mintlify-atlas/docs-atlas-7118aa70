              "features/sites",
              "features/services",
              "features/ssl-networking"
            ]
          },
          {
            "group": "Runtimes",
            "pages": [
              "runtimes/php",
              "runtimes/nodejs",
              "runtimes/mariadb",
              "runtimes/nginx"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/settings",
              "configuration/paths",
              "configuration/per-site-config"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/common-issues",
              "troubleshooting/logs",
              "troubleshooting/debugging"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "Commands",
            "pages": [
              "cli/overview",
              "cli/runtime-management",
              "cli/site-management",
              "cli/service-control"
            ]
          }
        ]
      }
    ]
