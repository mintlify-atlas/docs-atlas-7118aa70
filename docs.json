{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Envloom",
  "theme": "aspen",
  "colors": {
    "primary": "#8bcb3e",
    "light": "#0c3014",
    "dark": "#5dba1e"
  },
  "favicon": "https://media.brand.dev/de71a1ef-776f-44b2-83dd-c47997fa27b7.png",
  "logo": {
    "light": "https://media.brand.dev/1db1cf36-9796-4880-a354-664d093c361e.svg",
    "dark": "https://media.brand.dev/1db1cf36-9796-4880-a354-664d093c361e.svg"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/envloom/envloom"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/envloom/envloom"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
