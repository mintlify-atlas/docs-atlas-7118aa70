  "keyFeatures": [
    "Multi-version runtime management (PHP, Node.js, MariaDB, Nginx)",
    "Per-site configuration with custom PHP versions and SSL",
    "Automated local SSL certificates with local CA",
    "Service lifecycle management with auto-start options",
    "Desktop dashboard with system tray integration",
    "CLI tool for project-level runtime switching",
    "Laravel site scaffolding with starter kits",
    "Centralized logging and diagnostics",
    "Windows startup integration"
  ],
  "publicApiSurface": [
    "loom current - Show current runtime versions",
    "loom list <runtime> - List available versions",
    "loom link - Link existing project",
    "loom unlink - Unlink current project",
    "loom ssl on|off - Toggle SSL for current site",
    "loom php <version> - Switch PHP version",
    "loom node <version> - Switch Node.js version",
    "Desktop UI - Dashboard, runtime pages, sites, logs, settings",
    "System Tray - Quick actions, runtime switching, site links"
  ]
